  "pii_patterns": {
    "email_not_example": {
      "regex": "[A-Za-z0-9._%+-]+@(?!(?:[A-Za-z0-9-]+\\.)*example\\.(?:test|com)|localhost)[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "hint": "邮箱一律用 example.test 域（可带子域）"
    },
    "cn_mobile": {
      "regex": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
      "hint": "手机号用 13800000000 占位"
    },
    "cn_id": {
      "regex": "(?<!\\d)\\d{17}[\\dXx](?!\\d)",
      "hint": "证件号用 000000000000000000 占位"
    },
    "bearer_token": {
      "regex": "(?i)bearer\\s+[A-Za-z0-9._~+/-]{16,}",
      "hint": "token 只从环境变量读，不落盘"
    },
    "oauth_token": {
      "regex": "(?i)(access_token|refresh_token)\\s*[=:]\\s*[\"']?[A-Za-z0-9._~/-]{16,}",
      "hint": "token 只从环境变量读，不落盘"
    },
    "api_key": {
      "regex": "(?i)\\b(sk|pk|ak)-[A-Za-z0-9]{16,}",
      "hint": "密钥用 <API_KEY> 占位"
    },
    "md5_like": {
      "regex": "(?i)\\b(?:[a-f0-9]{32}|[a-f0-9]{40}|[a-f0-9]{64})\\b",
      "hint": "疑似哈希/签名，确认不是凭据再放行"
    }
  },
  "skip_globs": [
    "tools/wording_lexicon.json",
    "tools/wording_lint.py",
    "docs/WORDING_LEXICON.md",
    ".git/**",
    "**/__pycache__/**",
