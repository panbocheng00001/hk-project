{
  "version": 1,
  "note": "示例：真实主机与口径词放在本机（~/.hk-project/pagekit_terms.json 或 PAGEKIT_TERMS 指向的文件），不进仓库。",
  "hosts": [
    { "host": "abs3.example.test", "placeholder": "<SITE_HOST>" }
  ],
  "terms": [
    { "term": "示例发证机关", "placeholder": "<ISSUER>" },
    { "term": "示例牌照事务处", "placeholder": "<OFFICE>" },
    { "term": "示例热线", "placeholder": "<HOTLINE>" }
  ],
  "patterns": [
    { "name": "licence_no", "pattern": "\\b[A-Z]{1,2}\\d{6,8}\\b", "placeholder": "<LICENCE_NO>" },
    { "name": "booking_ref", "pattern": "\\b[A-Z0-9]{4}-?[A-Z0-9]{4}-?[A-Z0-9]{2,6}\\b", "placeholder": "<BOOKING_REF>" }
  ]
}
